# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds variable NAMES and where to get their
# values, never a value. LEKHA_TEST_DATABASE_URL in particular was undocumented
# anywhere, which is why the whole tests/db suite skipped silently for months.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI scratch (version cache), not source
supabase/.temp/

# Some external tool's upload-staging cache, not source — landed in the
# project root, and being untracked/un-ignored let Tailwind v4's default
# content auto-detection (which respects .gitignore) scan it, choke on a
# corrupted byte inside one of its ~80k blob files, and break the dev build
# for every session pointed at this repo. Ignoring it, not deleting it: it's
# read-only, dated days before this fix, and not this project's to remove
# without knowing what still expects it there.
.tmp.driveupload/
