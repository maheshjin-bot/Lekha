# Copy to .env.local and fill in. NEVER commit real values — .gitignore
# ignores every .env* except this template.

# ---------------------------------------------------------------------------
# Application (required for `npm run dev`)
# ---------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# Google AI Studio -> Get API key. Used by the support chat widget only;
# the app runs without it, the widget just returns an error.
GOOGLE_API_KEY=<google ai studio key>

# ---------------------------------------------------------------------------
# Database test suite (optional, but see the warning below)
# ---------------------------------------------------------------------------
# WITHOUT THIS VARIABLE THE ENTIRE tests/db SUITE SKIPS SILENTLY. It is not a
# small corner of the suite: 334 tests, including tests/db/invariants.test.ts,
# which is the only thing that checks "is production still internally
# consistent" — that every voucher balances, that every table has RLS, that no
# policy is reachable by anon. `npm run test` prints a healthy green run
# either way, so nothing tells you they did not execute.
#
# That silence has a cost, measured. When this was first set and the suite
# actually run (2 Sep 2026), it immediately failed on real, pre-existing
# problems that had been invisible for months: seven RLS policies scoped to
# PUBLIC instead of authenticated, three companies whose trial balance does
# not sum to zero, and several assertions referencing functions that had since
# been renamed. Set it.
#
# Value: Supabase Dashboard -> Project Settings -> Database -> Connection
# string -> "Session pooler" (port 5432; the transaction pooler on 6543 does
# not support the session-level SET that the impersonation helpers use). The
# password is the database password from that same page — it is NOT the
# publishable key, the service key, or your dashboard login.
#
#   LEKHA_TEST_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# Read-only against any database, including the live project, which is the
# intended use — "does production still balance" is a fact about the data.
# Keep it in your own shell or in .env.local; never in a committed file.
LEKHA_TEST_DATABASE_URL=

# Fixture-creating tests (triggers, RLS negatives) additionally need this set
# to 1. They write, and although every write runs inside a rollback, a
# rollback is no defence against a constraint-violating trigger test firing on
# real rows. Point LEKHA_TEST_DATABASE_URL at a local or seeded database
# before setting this — NEVER at the live project.
# LEKHA_TEST_ALLOW_WRITES=1
