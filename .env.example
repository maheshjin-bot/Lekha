# Supabase — LEKHA's own dedicated project.
#
# This must be a project created for LEKHA alone. Do not point it at HISAB's
# project or any other app's: the migrations create an `app_private` schema and
# seed reference data, and both would collide with an existing install.
#
# Both values below are public by design. Every privileged operation is gated
# by row-level security, not by key secrecy — which is why the publishable key
# is safe to ship to the browser.
#
# Never put the service_role key in this file or anywhere in the client bundle.
# It bypasses RLS entirely.
#
# Find both under: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini API key for the in-app support chat (app/api/support-chat, rendered
# by components/support/SupportChatWidget.tsx). Server-only — deliberately
# NOT prefixed NEXT_PUBLIC_, since this one *does* grant access to a billable
# (currently free-tier) API on Google's side and must never reach the client
# bundle. Get a key at https://aistudio.google.com/apikey. Leaving this unset
# disables the chat widget's backend; the route returns 503 rather than
# throwing, so the rest of the app is unaffected.
GOOGLE_API_KEY=

# WhatsApp bill forwarding (app/api/whatsapp/webhook, migration 0745). This
# app has no WhatsApp Business API app, verified phone number, or access
# token of its own — all three below are unset in every environment this
# was built in, and the webhook route is written against Meta's documented
# Cloud API contract but has never actually received or sent a real message.
# See that route's own header comment for the full "what's real vs what
# needs credentials" statement. Leaving all three unset disables the
# feature gracefully — the GET handshake returns 503, and the POST handler
# still receives Meta's notification metadata but cannot download the
# attachment or reply.
#
# WHATSAPP_VERIFY_TOKEN — a secret THIS APP chooses (not from Meta) and
# enters into Meta's webhook-setup UI; the GET handler checks Meta's
# hub.verify_token against it during the one-time verification handshake.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET — the Meta app's own secret, used only to verify the
# X-Hub-Signature-256 header Meta signs every webhook delivery with. If
# unset, signature verification is skipped (logged), not silently bypassed.
WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN — bearer token for the Graph API: downloading a
# forwarded attachment and sending the confirm-link reply both need it.
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Database test suite (optional, but see the warning below)
# ---------------------------------------------------------------------------
# WITHOUT THIS VARIABLE THE ENTIRE tests/db SUITE SKIPS SILENTLY. It is not a
# small corner of the suite: it includes tests/db/invariants.test.ts, which is
# the only thing that checks "is production still internally consistent" —
# that every voucher balances, that every table has RLS, that no policy is
# reachable by anon. `npm run test` prints a healthy green run either way, so
# nothing tells you these did not execute.
#
# That silence has a real cost: when this was first set and the suite
# actually run, it immediately failed on real, pre-existing problems that had
# been invisible for months — RLS policies scoped to PUBLIC instead of
# authenticated, and companies whose trial balance did not sum to zero. Set
# it.
#
# Value: Supabase Dashboard -> Project Settings -> Database -> Connection
# string -> "Session pooler" (port 5432; the transaction pooler on 6543 does
# not support the session-level SET that the impersonation helpers use). The
# password is the database password from that same page — it is NOT the
# publishable key, the service key, or your dashboard login.
#
#   LEKHA_TEST_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# Read-only against any database, including the live project, which is the
# intended use — "does production still balance" is a fact about the data.
# Keep it in your own shell or in .env.local; never in a committed file.
LEKHA_TEST_DATABASE_URL=

# Fixture-creating tests (triggers, RLS negatives) additionally need this set
# to 1. They write, and although every write runs inside a rollback, a
# rollback is no defence against a constraint-violating trigger test firing on
# real rows. Point LEKHA_TEST_DATABASE_URL at a local or seeded database
# before setting this — NEVER at the live project.
# LEKHA_TEST_ALLOW_WRITES=1
